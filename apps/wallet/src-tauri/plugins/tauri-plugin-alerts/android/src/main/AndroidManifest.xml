<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Payment notifications (runtime prompt on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The "Watching for payments" service that keeps the wallet connected
         with the app closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Asks (a system dialog) to keep the network while the phone dozes. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- A short buzz when a payment lands on the Receive screen. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <service
            android:name="io.btcsessions.alerts.WatchService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a self-custodial Bitcoin wallet connected to its chain server and Lightning provider so it can alert the user to incoming payments while the app is closed." />
        </service>
    </application>
</manifest>
