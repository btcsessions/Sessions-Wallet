{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The wallet window may only call the wallet's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://connect.trezor.io/*"
        },
        {
          "url": "trezorsuite://*"
        },
        {
          "url": "https://mempool.space/*"
        },
        {
          "url": "nostr+walletconnect://*"
        }
      ]
    }
  ]
}
