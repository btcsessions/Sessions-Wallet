{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sessions Wallet",
  "version": "0.1.42",
  "identifier": "io.btcsessions.wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sessions Wallet",
        "width": 1070,
        "height": 770,
        "minWidth": 380,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:21335"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Build-your-own bitcoin wallet",
    "longDescription": "A self-custodial bitcoin wallet you assemble from modules: Lightning and Spark spending, on-chain savings, multisig vaults, hardware wallets, Liquid swaps and ecash.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/udev/rules.d/53-sessions-wallet-bitbox02.rules": "linux/53-hid-bitbox02.rules",
          "/etc/udev/rules.d/54-sessions-wallet-bitbox02.rules": "linux/54-hid-bitbox02.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/etc/udev/rules.d/53-sessions-wallet-bitbox02.rules": "linux/53-hid-bitbox02.rules",
          "/etc/udev/rules.d/54-sessions-wallet-bitbox02.rules": "linux/54-hid-bitbox02.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "sessionswallet"
          ],
          "host": "trezor",
          "appLink": false
        },
        {
          "scheme": [
            "sessionswallet"
          ],
          "host": "join",
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "sessionswallet"
        ]
      }
    }
  }
}
