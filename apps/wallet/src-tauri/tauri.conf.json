{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sessions Wallet",
  "version": "0.1.1",
  "identifier": "io.btcsessions.wallet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sessions Wallet",
        "width": 480,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Build-your-own bitcoin wallet",
    "longDescription": "A self-custodial bitcoin wallet you assemble from modules: Lightning and Spark spending, on-chain savings, multisig vaults, hardware wallets, Liquid swaps and ecash.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
